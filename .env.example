# 复制为 .env 并按需填写；.env 已被 .gitignore 排除，禁止提交

# ---- RSSHub（B站动态源）----
RSSHUB_BASE=http://localhost:1200

# ---- OCR 侧车（RapidOCR HTTP 服务）----
# 变量名以 src/processing/ocr.ts 为准：OCR_SERVICE_URL（不是 OCR_BASE）
# pnpm ocr（start.js）默认起在 127.0.0.1:1225；单图超时在 ocr.ts 硬编码 120s
OCR_SERVICE_URL=http://127.0.0.1:1225
OCR_BATCH_LIMIT=300        # 单次同步最多识别张数
OCR_MAX_ATTEMPTS=3         # 单图最大尝试次数，超过即放弃

# ---- LLM 结构化（OpenAI 兼容协议：DeepSeek/GLM/Kimi/本地 Ollama 均可）----
# 未配置 LLM_BASE_URL 时结构化步骤自动跳过
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=120000
LLM_BATCH_LIMIT=10         # 单次同步最多送 LLM 的动态条数
EXTRACT_MAX_ATTEMPTS=3     # 单条动态最大尝试次数

# ---- 调度与日志 ----
FETCH_INTERVAL_MINUTES=    # 留空=每天 00:00；填数字=固定间隔分钟
LOG_LEVEL=info             # debug 可看每次 HTTP 进出
LOG_PRETTY=1               # 0=JSON 行（服务器采集）
