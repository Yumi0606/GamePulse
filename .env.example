# 复制为 .env 并按需填写；.env 已被 .gitignore 排除，禁止提交

# ---- RSSHub（B站动态源）----
RSSHUB_BASE=http://localhost:1200

# ---- OCR 侧车（RapidOCR HTTP 服务）----
# 变量名以 src/processing/ocr.ts 为准：OCR_SERVICE_URL（不是 OCR_BASE）
# pnpm ocr（start.js）默认起在 127.0.0.1:1225；单图超时在 ocr.ts 硬编码 120s
OCR_SERVICE_URL=http://127.0.0.1:1225
OCR_BATCH_LIMIT=300        # 每轮处理链最多识别张数（代码默认 20）
OCR_MAX_ATTEMPTS=3         # 单图最大尝试次数，超过即放弃；基础设施失败不计数

# ---- LLM 结构化（OpenAI 兼容协议：DeepSeek/GLM/Kimi/本地 Ollama 均可）----
# LLM_BASE_URL 与 LLM_MODEL 均非空时结构化才启用，否则该步骤自动跳过
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=120000
LLM_BATCH_LIMIT=10         # 每轮处理链最多送 LLM 的动态条数
EXTRACT_MAX_ATTEMPTS=3     # 单条动态最大尝试次数，超过即放弃；基础设施失败不计数

# ---- 调度与日志 ----
# 触发方式优先级（两条循环各自独立）：cron 表达式 > 固定间隔 > 每天 00:00（拉取循环专属）
# cron 标准 5 字段：分 时 日 月 周（如 "15 8 * * 1-5"=工作日 8:15；"*/10 * * * *"=每 10 分钟）
# cron 固定按北京时间解释；表达式非法时打 error 日志并回落下一级方式
FETCH_CRON=                 # 拉取循环 cron；留空则看 FETCH_INTERVAL_MINUTES
PROCESS_CRON=               # 处理链循环 cron；留空则看 PROCESS_INTERVAL_MINUTES
FETCH_INTERVAL_MINUTES=     # 留空=每天北京时间 00:00；填数字=固定间隔分钟
PROCESS_INTERVAL_MINUTES=30 # 处理链（OCR+LLM）独立清积压的间隔分钟，最小 5
LOG_LEVEL=info             # debug 可看每次 HTTP 进出
LOG_PRETTY=1               # 0=JSON 行（服务器采集）
LOG_FILE=logs/app.log      # 日志落盘路径；留空串关闭落盘

# ---- 重试策略 ----
OCR_RETRY_COOLDOWN=300     # OCR 失败重试冷却秒数（0=不冷却）；基础设施失败不消耗尝试次数
LLM_RETRY_COOLDOWN=300     # LLM 失败重试冷却秒数（0=不冷却）；基础设施失败不消耗尝试次数
