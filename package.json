{
  "name": "gamepulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GamePulse 游戏活动数据源整合：官号动态 → OCR → LLM 结构化 → SQLite + JSON API / RSS",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "pnpm -r build",
    "sync": "tsx apps/server/src/index.ts",
    "ocr": "node ocr-service/start.js",
    "web": "tsx apps/server/src/web/server.ts",
    "viewonly": "tsx apps/server/src/web/server.ts --view-only",
    "dev": "tsx apps/server/src/web/server.ts --web-dev --view-only"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
