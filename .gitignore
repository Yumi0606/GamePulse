# 依赖
node_modules/

# 构建产物
dist/

# 本地数据存储（条目库存与拉取统计，不入库）
data/

# OCR 侧车虚拟环境
ocr-service/.venv/

# Python 字节码缓存（解释器导入时自动生成，随解释器版本变化）
__pycache__/
*.py[cod]

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 环境变量与密钥（禁止提交任何凭证）；模板文件除外
.env
.env.*
*.env
!.env.example

# 探针目录内的依赖与测试图片
_research/ocr_probe/.venv/
_research/ocr_probe/*.png

# 系统/编辑器
Thumbs.db
.DS_Store
